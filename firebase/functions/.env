# הגדרות של הפונקציות (לא סודות). נקראות גם בפרסום וגם באמולטור.
SCAN_DAILY_LIMIT=100
SCAN_MAX_FILE_MB=10
MAX_PUSH_TOKENS=5
GEMINI_API_BASE=https://generativelanguage.googleapis.com
# ריק = ה-bucket שמוגדר כברירת מחדל בפרויקט
BACKUP_BUCKET=
# מכשיר אחד למשתמש (one-device.js): on = פעיל | log = רק יומן, אף אחד לא מנותק | off = כבוי (מתג חירום)
ONE_DEVICE=on
