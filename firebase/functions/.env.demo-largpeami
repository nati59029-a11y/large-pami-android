# רק לפרויקט הדמה של האמולטור (demo-largpeami): Gemini מוחלף בשרת דמה מקומי. אין שום פנייה החוצה.
GEMINI_API_BASE=http://127.0.0.1:9799
SCAN_RETRY_WAIT_MS=10
# אותו bucket שבו הבדיקות (rules-unit-testing) שומרות קבצים באמולטור
BACKUP_BUCKET=demo-largpeami
# רק באמולטור: כל זמני ההמתנה של scanDocument מוכפלים ב-0.05 (תקציב 100 שניות → 5 שניות), כדי שבדיקות התקציב יהיו קצרות
SCAN_TIME_SCALE=0.05
# ימות המשיח מוחלף בשרת דמה מקומי (tests/yemot-mock.js). אין שום פנייה לימות האמיתי.
YEMOT_API_BASE=http://127.0.0.1:9797/ym/api/
# הקול: בבדיקות האמולטור הקיימות – הקול הממוחשב של ימות (כמו קודם). הקול המשוכפל נבדק בתוך תהליך הבדיקה (61-yemot-line.js) מול שרת דמה.
VOICE_ENGINE=yemot-tts
# ElevenLabs מוחלף בשרת דמה מקומי (tests/elevenlabs-mock.js). אין שום פנייה החוצה.
ELEVENLABS_API_BASE=http://127.0.0.1:9796
VOICE_CACHE_BUCKET=demo-largpeami
# הרשומה החד-פעמית במילון כבויה כאן, כדי שבדיקות המילון הקיימות יראו בדיוק את מה שכתבו
LEXICON_SEED=off
# ווצאפ של המזכירה (שלב 5): ה-Graph API של Meta מוחלף בשרת דמה מקומי (tests/wa-mock.js). אין שום פנייה ל-Meta.
WA_GRAPH_BASE=http://127.0.0.1:9795
# Gmail ויומן Google של המזכירה (שלב 6): Google מוחלפת בשרת דמה מקומי (tests/google-mock.js). אין שום פנייה ל-Google. Client ID ו-redirect – ערכי דמה.
GOOGLE_API_BASE=http://127.0.0.1:9794
GOOGLE_CLIENT_ID=test-client.apps.googleusercontent.invalid
GOOGLE_OAUTH_REDIRECT=http://127.0.0.1:5001/demo-largpeami/us-central1/secOAuthCb
