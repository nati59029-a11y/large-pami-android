rules_version = '2';

// כללי הרשאות ל-Storage (אחסון קבצים) – שלב 0.
// מקור: פרק 20.3 באפיון (התיקייה app_backups/{uid}/) ופרק 3.3 ("כל השאר: אף אחד").
// עיקרון: הכול סגור, ופותחים רק את תיקיית הגיבוי של האפליקציה ואת תיקיית עדכוני ה-APK (קריאה בלבד).
// התפקיד נבדק מול Firestore בכל בקשה (admins/{uid} = מנהל; staff/{uid} עם active == true = עובד).
// אין בשום מקום תנאי שמסתפק רק בכך שהמשתמש מחובר.

service firebase.storage {
  match /b/{bucket}/o {

    function isManager() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isActiveEmployee() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    function isStaff() {
      return isManager() || isActiveEmployee();
    }

    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // גיבוי מוצפן של האפליקציה: כל משתמש בתיקייה של עצמו.
    // קריאה: המשתמש עצמו (עובד פעיל או מנהל); מנהל – קריאה של כל התיקיות.
    // כתיבה: רק המשתמש עצמו, רק עובד פעיל או מנהל, רק קובץ בינארי (מוצפן), עד 50MB (הנחה מהאפיון).
    // הערה: הכלל לא יכול לוודא שהתוכן באמת מוצפן. הוא מוודא רק את סוג הקובץ המוצהר ואת הגודל.
    match /app_backups/{userId}/{fileName} {
      allow read: if (isSelf(userId) && isStaff()) || isManager();
      allow create, update: if isSelf(userId) && isStaff()
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      // מחיקה – כדי שהאפליקציה תשמור רק 30 גרסאות אחרונות (שלב 5).
      allow delete: if isSelf(userId) && isStaff();
    }

    // עדכוני APK (app_releases/): ה-APK וקובץ הגרסה שלו, שתהליך הבנייה מעלה ב-main.
    // קריאה (כולל רשימה): רק עובד פעיל או מנהל מחובר – אותו תנאי של הגיבוי.
    // כתיבה ומחיקה: אסורות לכולם. ההעלאה נעשית רק בתהליך הבנייה, עם מפתח גישה של חשבון שירות,
    // שעוקף את הכללים.
    match /app_releases/{allPaths=**} {
      // ריבוי עסקים (שלב 5, סבב 2): לכל היותר 2 מסמכים בכל מסלול – users/{uid} ו-superadmins/{uid} (עדכון חוזה 6).
      // חבר פעיל בכל עסק, כולל לארג' פעמי במצב legacy (מסמך users שכלי ההעברה יוצר, והשרת מסנכרן מ-admins/staff
      // בשורש – syncLegacyAdmin / syncLegacyStaff), גם כשהעסק מושהה (עדכוני אבטחה), ומנהל־על.
      // משתמש שורש בלי מסמך users נחסם, ולכן מפרסמים את הכלל רק אחרי ההעברה והפונקציות (ראו 5-שרת.md).
      allow read: if relMember();
      allow write: if false;
    }

    // ---------- ריבוי עסקים (משימה 2026-11-05, שלבים 2 ו-5) ----------
    // הכללים בשורש (app_backups/) לא השתנו. app_releases/ – ראו למעלה (קורא רק users ו-superadmins).
    // עדכון חוזה 6: בכל הערכה בתוך b/{bizId} לכל היותר 2 קריאות מסמכים ל-Firestore: users/{uid} ו-superadmins/{uid}.
    // השרת (שלב 5) שומר ב-users/{uid} עותק מעודכן: bizId, role ('admin'/'worker'), active, bizStatus ('active'/'suspended').
    // מנהל = role 'admin'; עובד = role 'worker'; שניהם active == true ו-bizStatus == 'active', בעסק של הנתיב.
    // מנהל־על = superadmins/{uid} (מנהל מלא בכל עסק, גם מושהה). users/{uid} חסר = get נכשל = לא חבר (מנהל־על עדיין עובר).
    function uDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function uIn(bizId, role) {
      return request.auth != null && uDoc().get('bizId', '') == bizId && uDoc().get('role', '') == role
        && uDoc().get('active', false) == true && uDoc().get('bizStatus', '') == 'active';
    }
    function bSuper() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/superadmins/$(request.auth.uid));
    }
    function bMgr(bizId) {
      return uIn(bizId, 'admin') || bSuper();
    }
    function bEmp(bizId) {
      return uIn(bizId, 'worker');
    }
    function bStaff(bizId) {
      return uIn(bizId, 'admin') || uIn(bizId, 'worker') || bSuper();
    }
    // חבר פעיל בעסק כלשהו, לעדכוני APK: לא תלוי בסטטוס העסק, כדי שגם עסק מושהה יקבל עדכוני אבטחה (עדכון חוזה 6).
    function relMember() {
      return request.auth != null
        && ((uDoc().get('active', false) == true && uDoc().get('role', '') in ['admin', 'worker']) || bSuper());
    }

    // גיבוי מוצפן של האפליקציה בתוך העסק: אותם תנאים כמו app_backups/ בשורש, עם התפקיד בתוך העסק.
    match /b/{bizId}/app_backups/{userId}/{fileName} {
      allow read: if (isSelf(userId) && bStaff(bizId)) || bMgr(bizId);
      allow create, update: if isSelf(userId) && bStaff(bizId)
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      allow delete: if isSelf(userId) && bStaff(bizId);
    }

    // לוגו העסק: קריאה – חברי העסק. כתיבה ומחיקה – מנהל העסק (ומנהל־על). png/jpeg/webp עד 1MB.
    match /b/{bizId}/brand/logo {
      allow read: if bStaff(bizId);
      allow create, update: if bMgr(bizId)
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow delete: if bMgr(bizId);
    }

    // הכלל האחרון: כל מה שלא הוגדר למעלה סגור לכולם.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
