rules_version = '2';

// כללי הרשאות ל-Storage (אחסון קבצים) – שלב 0.
// מקור: פרק 20.3 באפיון (התיקייה app_backups/{uid}/) ופרק 3.3 ("כל השאר: אף אחד").
// עיקרון: הכול סגור, ופותחים רק את תיקיית הגיבוי של האפליקציה ואת תיקיית עדכוני ה-APK (קריאה בלבד).
// התפקיד נבדק מול Firestore בכל בקשה (admins/{uid} = מנהל; staff/{uid} עם active == true = עובד).
// אין בשום מקום תנאי שמסתפק רק בכך שהמשתמש מחובר.

service firebase.storage {
  match /b/{bucket}/o {

    function isManager() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isActiveEmployee() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    function isStaff() {
      return isManager() || isActiveEmployee();
    }

    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // גיבוי מוצפן של האפליקציה: כל משתמש בתיקייה של עצמו.
    // קריאה: המשתמש עצמו (עובד פעיל או מנהל); מנהל – קריאה של כל התיקיות.
    // כתיבה: רק המשתמש עצמו, רק עובד פעיל או מנהל, רק קובץ בינארי (מוצפן), עד 50MB (הנחה מהאפיון).
    // הערה: הכלל לא יכול לוודא שהתוכן באמת מוצפן. הוא מוודא רק את סוג הקובץ המוצהר ואת הגודל.
    match /app_backups/{userId}/{fileName} {
      allow read: if (isSelf(userId) && isStaff()) || isManager();
      allow create, update: if isSelf(userId) && isStaff()
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      // מחיקה – כדי שהאפליקציה תשמור רק 30 גרסאות אחרונות (שלב 5).
      allow delete: if isSelf(userId) && isStaff();
    }

    // עדכוני APK (app_releases/): ה-APK וקובץ הגרסה שלו, שתהליך הבנייה מעלה ב-main.
    // קריאה (כולל רשימה): רק עובד פעיל או מנהל מחובר – אותו תנאי של הגיבוי.
    // כתיבה ומחיקה: אסורות לכולם. ההעלאה נעשית רק בתהליך הבנייה, עם מפתח גישה של חשבון שירות,
    // שעוקף את הכללים.
    match /app_releases/{allPaths=**} {
      // ריבוי עסקים (שלב 5, סבב 2): לכל היותר 2 מסמכים בכל מסלול – users/{uid} ו-superadmins/{uid} (עדכון חוזה 6).
      // חבר פעיל בכל עסק, כולל לארג' פעמי במצב legacy (מסמך users שכלי ההעברה יוצר, והשרת מסנכרן מ-admins/staff
      // בשורש – syncLegacyAdmin / syncLegacyStaff), גם כשהעסק מושהה (עדכוני אבטחה), ומנהל־על.
      // משתמש שורש בלי מסמך users נחסם, ולכן מפרסמים את הכלל רק אחרי ההעברה והפונקציות (ראו 5-שרת.md).
      allow read: if relMember();
      allow write: if false;
    }

    // ---------- ריבוי עסקים (משימה 2026-11-05, שלבים 2 ו-5) ----------
    // הכללים בשורש (app_backups/) לא השתנו. app_releases/ – ראו למעלה (קורא רק users ו-superadmins).
    // עדכון חוזה 6: בכל הערכה בתוך b/{bizId} לכל היותר 2 קריאות מסמכים ל-Firestore: users/{uid} ו-superadmins/{uid}.
    // השרת (שלב 5) שומר ב-users/{uid} עותק מעודכן: bizId, role ('admin'/'worker'), active, bizStatus ('active'/'suspended').
    // מנהל = role 'admin'; עובד = role 'worker'; שניהם active == true ו-bizStatus == 'active', בעסק של הנתיב.
    // מנהל־על = superadmins/{uid} (מנהל מלא בכל עסק, גם מושהה). users/{uid} חסר = get נכשל = לא חבר (מנהל־על עדיין עובר).
    function uDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function uIn(bizId, role) {
      return request.auth != null && uDoc().get('bizId', '') == bizId && uDoc().get('role', '') == role
        && uDoc().get('active', false) == true && uDoc().get('bizStatus', '') == 'active';
    }
    function bSuper() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/superadmins/$(request.auth.uid));
    }
    function bMgr(bizId) {
      return uIn(bizId, 'admin') || bSuper();
    }
    function bEmp(bizId) {
      return uIn(bizId, 'worker');
    }
    function bStaff(bizId) {
      return uIn(bizId, 'admin') || uIn(bizId, 'worker') || bSuper();
    }
    // חבר פעיל בעסק כלשהו, לעדכוני APK: לא תלוי בסטטוס העסק, כדי שגם עסק מושהה יקבל עדכוני אבטחה (עדכון חוזה 6).
    function relMember() {
      return request.auth != null
        && ((uDoc().get('active', false) == true && uDoc().get('role', '') in ['admin', 'worker']) || bSuper());
    }

    // גיבוי מוצפן של האפליקציה בתוך העסק: אותם תנאים כמו app_backups/ בשורש, עם התפקיד בתוך העסק.
    match /b/{bizId}/app_backups/{userId}/{fileName} {
      allow read: if (isSelf(userId) && bStaff(bizId)) || bMgr(bizId);
      allow create, update: if isSelf(userId) && bStaff(bizId)
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      allow delete: if isSelf(userId) && bStaff(bizId);
    }

    // לוגו העסק: קריאה – חברי העסק. כתיבה ומחיקה – מנהל־על בלבד (עדכון חוזה 14; קריאה אחת: superadmins/{uid}).
    // מנהל העסק ועובד – קריאה בלבד. png/jpeg/webp עד 1MB. מסמך brand עצמו נשמר רק דרך setBusinessBrand (audit).
    match /b/{bizId}/brand/logo {
      allow read: if bStaff(bizId);
      allow create, update: if bSuper()
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow delete: if bSuper();
    }

    // מסמכים ללקוח (14.11.2026, שלב 3): ar/{bizId}/{docId}.pdf (אישורי הזמנה ובהמשך חשבוניות) – בכוונה בלי כלל, ולכן סגור לכולם.
    // רק השרת (Admin) כותב וקורא: האפליקציה מקבלת את הקובץ דרך arPdf (בדיקת הרשאה), והלקוח – דרך arFile (קישור עם אסימון).
    // סריקת חנות בתלת מימד – store3d (14.11.2026; חוזה, סעיף 5): תמונות מדפים, צילומי אימות וטקסטורות.
    // כתיבה ומחיקה: אף לקוח – רק השרת (shelfCheck / mapDraft / s3PutTex / s3PutPano, Admin SDK), אחרי בדיקת סוג לפי התוכן, גודל, ו"אין אדם בתמונה".
    // קריאה: חברי העסק (bStaff – 2 קריאות: users/{uid}, superadmins/{uid}; בדיקת התוספת הייתה קריאה שלישית – לכן היא נאכפת
    // בכך שבלי התוספת השרת לא שומר קבצים). רק get של קובץ בודד (אין list – הנתיבים מגיעים מ-Firestore), רק בנתיבים
    // המוגדרים, רק JPEG (contentType image/jpeg, סיומת .jpg) ורק עד הגודל שבחוזה: מלאה 1,500,000 בתים, מוקטנת (_t) 150,000,
    // טקסטורה 600,000.
    function s3Jpg(max) {
      return resource.contentType == 'image/jpeg' && resource.size <= max;
    }
    match /b/{bizId}/store3d/{brId}/{kind}/{folder}/{file} {
      allow get: if bStaff(bizId) && brId.matches('^[a-z0-9_]{2,20}$') && (
        (kind == 'run' && folder.matches('^([a-z0-9]{6,20}_[0-9]{8}|[a-z0-9]{6,20}_m[0-9]{13}|ad_[A-Za-z0-9-]{16,40})$')
          && ((file.matches('^f[0-9]{1,4}-[ab]-[0-9]{1,2}_[atb]_[0-9]{1,2}[.]jpg$') && s3Jpg(1500000))
              || (file.matches('^f[0-9]{1,4}-[ab]-[0-9]{1,2}_[atb]_[0-9]{1,2}_t[.]jpg$') && s3Jpg(150000))))
        || (kind == 'tex' && folder.matches('^[sw]-[a-z0-9_]{2,20}$')
          && file.matches('^t[0-9]{1,4}_[0-9]{1,2}[.]jpg$') && s3Jpg(600000))
        // שלב 18א (15.11.2026): סיור 360 – מלאה (p{n}_{גרסה}.jpg) עד 8,000,000 בתים (שלב 21ו, 8192×4096; היה 3,000,000), קטנה (_s) עד 200,000. כתיבה – רק s3PutPano.
        || (kind == 'pano' && folder.matches('^[sw]-[a-z0-9_]{2,20}$')
          && ((file.matches('^p[0-9]{1,4}_[0-9]{1,4}[.]jpg$') && s3Jpg(8000000))
              || (file.matches('^p[0-9]{1,4}_[0-9]{1,4}_s[.]jpg$') && s3Jpg(200000)))));
      // עדכון 7ב: הנתיב draft/ הוסר מהקריאה (מינימום הרשאה) – השרת לא שומר את תמונות טיוטת המפה (שלב 8). אם יישמרו בעתיד – להחזיר כאן.
      allow list, write: if false;
    }
    match /b/{bizId}/store3d/{brId}/fix/{file} {
      allow get: if bStaff(bizId) && brId.matches('^[a-z0-9_]{2,20}$') && (
        (file.matches('^[A-Za-z0-9_-]{6,80}_[0-9]{1,2}[.]jpg$') && !file.matches('.*_t[.]jpg$') && s3Jpg(1500000))
        || (file.matches('^[A-Za-z0-9_-]{6,80}_[0-9]{1,2}_t[.]jpg$') && s3Jpg(150000)));
      allow list, write: if false;
    }

    // קול, תמונה וסרטון למזכירה (15.11.2026, secretary-media.js): סרטון בדרך לשרת – sec_tmp/{uid}/{file} (עסק legacy) ו-b/{bizId}/sec_tmp/{uid}/{file}.
    // יצירה: רק המשתמש עצמו, רק מנהל (legacy: admins/{uid}; בעסק: bMgr – 2 קריאות), עד 12MB, רק סרטון (webm/mp4/3gpp/quicktime), שם קובץ אקראי.
    // קריאה, רשימה ועדכון (דריסה): אסורים לכולם – רק השרת (secMedia) קורא, ומוחק מיד אחרי ההורדה. מחיקה: המשתמש עצמו (ביטול שליחה).
    // הרשאת המזכירה (תוספת, הסכמה) נאכפת בשרת; קובץ שלא עובד נמחק בכל מקרה ב-secMediaClean (20 דקות).
    function secTmpOk(fname) {
      return request.resource.size <= 12 * 1024 * 1024
        && request.resource.contentType.matches('^video/(webm|mp4|3gpp|quicktime)(;.*)?$')
        && fname.matches('^[A-Za-z0-9_-]{8,64}([.](webm|mp4|3gp|mov))?$');
    }
    match /sec_tmp/{userId}/{fileName} {
      allow create: if resource == null && isSelf(userId) && isManager() && secTmpOk(fileName); // resource == null: בלי דריסת קובץ קיים (גם אם האמולטור מסווג דריסה כ-create)
      allow delete: if isSelf(userId) && isManager();
      allow read, update: if false;
    }
    match /b/{bizId}/sec_tmp/{userId}/{fileName} {
      allow create: if resource == null && isSelf(userId) && bMgr(bizId) && secTmpOk(fileName);
      allow delete: if isSelf(userId) && bMgr(bizId);
      allow read, update: if false;
    }

    // דיווח יומי (dailyRep, 16.11.2026): הקלטות העובדים – b/{bizId}/dr/{id}/a{i}.wav. רק השרת (Admin SDK) כותב וקורא;
    // ההשמעה למנהל דרך drMgr op 'audio'. כלל חוסם מפורש (הכלל הכללי למטה כבר חוסם – זה רק תיעוד והגנה מפני כלל רחב בעתיד).
    match /b/{bizId}/dr/{allPaths=**} {
      allow read, write: if false;
    }

    // הכלל האחרון: כל מה שלא הוגדר למעלה סגור לכולם.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
