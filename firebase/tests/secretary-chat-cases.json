{
  "_": "30 שאלות בדיקה למזכירה (שלב 2, קריטריון: כל מספר עם מקור נכון). calls = מה שהמודל המדומה מבקש; answer = התשובה שהוא כותב, עם {כלי.נתיב} שממולא מתוצאת הכלי. [שדה=ערך] = חיפוש ברשימה. M0/M1 = החודש הנוכחי / הקודם. opt: pay = מתג שכר פעיל, emp = ניתוח עובדים פעיל, mirror = בלי נתונים מהמכשיר (מהמראה), stale = מראה ישן",
  "cases": [
    { "id": 1, "q": "כמה הכנסות היו החודש?", "calls": [["getMonthSummary", { "month": "M0" }]], "answer": "ההכנסות החודש: {getMonthSummary.income} ₪." },
    { "id": 2, "q": "כמה הוצאנו החודש?", "calls": [["getMonthSummary", { "month": "M0" }]], "answer": "ההוצאות החודש: {getMonthSummary.expenses} ₪." },
    { "id": 3, "q": "מה הרווח החודש?", "calls": [["getMonthSummary", { "month": "M0" }]], "answer": "הרווח החודש {getMonthSummary.profit} ₪, רווחיות {getMonthSummary.profitPct}%." },
    { "id": 4, "q": "כמה משכתי החודש כבעלים?", "calls": [["getMonthSummary", { "month": "M0" }]], "answer": "משיכות בעלים החודש: {getMonthSummary.ownerWithdrawals} ₪." },
    { "id": 5, "q": "כמה הוצאנו על ספקים החודש?", "calls": [["getMonthSummary", { "month": "M0" }]], "answer": "על ספקים: {getMonthSummary.byCategory[category=ספקים].total} ₪." },
    { "id": 6, "q": "איך ההכנסות בחודש שעבר לעומת שנה שעברה?", "calls": [["getMonthSummary", { "month": "M1" }]], "answer": "בחודש שעבר {getMonthSummary.income} ₪, ואשתקד {getMonthSummary.lastYear.income} ₪ – שינוי של {getMonthSummary.incomeChangePct}%." },
    { "id": 7, "q": "ההוצאות בחודש שעבר עלו מול שנה שעברה?", "calls": [["getMonthSummary", { "month": "M1" }]], "answer": "ההוצאות {getMonthSummary.expenses} ₪ מול {getMonthSummary.lastYear.expenses} ₪ אשתקד ({getMonthSummary.expenseChangePct}%)." },
    { "id": 8, "q": "כמה חשבוניות פתוחות יש לנו?", "calls": [["getOpenInvoices", {}]], "answer": "יש {getOpenInvoices.count} חשבוניות פתוחות, בסך {getOpenInvoices.total} ₪." },
    { "id": 9, "q": "כמה אנחנו באיחור לספקים?", "calls": [["getOpenInvoices", {}]], "answer": "באיחור: {getOpenInvoices.lateTotal} ₪." },
    { "id": 10, "q": "מה פתוח לספק החלב?", "calls": [["getOpenInvoices", { "supplier": "חלב" }]], "answer": "לספק החלב פתוחות חשבוניות בסך {getOpenInvoices.total} ₪; הגדולה ביתרה {getOpenInvoices.items.0.balance} ₪." },
    { "id": 11, "q": "כמה אני חייב לספק החלב?", "calls": [["getSupplierBalance", { "supplier": "ספק החלב" }]], "answer": "היתרה לספק החלב אחרי זיכויים: {getSupplierBalance.suppliers.0.balance} ₪." },
    { "id": 12, "q": "וכמה למאפיית הצפון?", "calls": [["getSupplierBalance", { "supplier": "מאפיית הצפון" }]], "answer": "למאפיית הצפון: {getSupplierBalance.suppliers.0.balance} ₪." },
    { "id": 13, "q": "איך נראה התזרים ב-13 השבועות הקרובים?", "calls": [["getCashflowForecast", {}]], "answer": "יציאות ממוצעות בשבוע {getCashflowForecast.avgWeeklyOut} ₪, הכנסות בין {getCashflowForecast.incomeRangeWeekly.0} ל-{getCashflowForecast.incomeRangeWeekly.1} ₪ בשבוע. סף מוצע להתראה: {getCashflowForecast.suggestedThreshold} ₪." },
    { "id": 14, "q": "יש לי היום 20,000 בבנק. מתי הכי נמוך?", "calls": [["getCashflowForecast", { "startBalance": 20000 }]], "answer": "הנקודה הנמוכה בתרחיש הזהיר: {getCashflowForecast.lowest.balLo} ₪." },
    { "id": 15, "q": "מה יקרה אם אקנה מלאי לחג ב-30 אלף בשבוע 3? יש לי 20000 בבנק", "calls": [["simulateScenario", { "amount": 30000, "week": 3, "direction": "out", "startBalance": 20000 }]], "answer": "עם הקנייה, הנקודה הנמוכה: {simulateScenario.withScenario.lowest.balLo} ₪ (בלעדיה {simulateScenario.base.lowest.balLo} ₪)." },
    { "id": 16, "q": "ואם תיכנס הכנסה מיוחדת של 12000 בשבוע 2, עם 15000 בבנק?", "calls": [["simulateScenario", { "amount": 12000, "week": 2, "direction": "in", "startBalance": 15000 }]], "answer": "היתרה הזהירה בסוף שבוע 2: {simulateScenario.withScenario.weeks.1.balLo} ₪." },
    { "id": 17, "q": "כדאי לקחת הלוואה של 100,000 בריבית 6% ל-36 חודשים?", "calls": [["loanCalc", { "principal": 100000, "annualRatePct": 6, "months": 36 }]], "answer": "ההחזר החודשי המשוער {loanCalc.monthlyPayment} ₪, וסך הריבית {loanCalc.totalInterest} ₪." },
    { "id": 18, "q": "ובקרן שווה, 60,000 ב-5% ל-24 חודשים?", "calls": [["loanCalc", { "principal": 60000, "annualRatePct": 5, "months": 24, "type": "equal" }]], "answer": "תשלום ראשון {loanCalc.firstPayment} ₪, אחרון {loanCalc.lastPayment} ₪, ריבית {loanCalc.totalInterest} ₪." },
    { "id": 19, "q": "יש רעיונות איך לשפר את העסק?", "calls": [["getImprovementIdeas", {}]], "answer": "ראיתי שהוצאות ספקים בחודש שעבר היו {getImprovementIdeas.ideas[key^=catUp].now} ₪ מול {getImprovementIdeas.ideas[key^=catUp].before} ₪ אשתקד. כדאי לבדוק מחירים." },
    { "id": 20, "q": "כמה משימות היו לעובדים החודש?", "calls": [["getTasks", { "days": 30 }]], "answer": "נפתחו {getTasks.total} משימות." },
    { "id": 21, "q": "כמה משימות היו לדוד?", "calls": [["getTasks", { "days": 30 }]], "answer": "לדוד כהן {getTasks.byEmployee[name=דוד כהן].total} משימות." },
    { "id": 22, "q": "מה עם סגירות הקופה בחודש האחרון?", "calls": [["getCashClosings", {}]], "answer": "בחודש האחרון {getCashClosings.count} סגירות; באחרונה מזומן {getCashClosings.items.0.amounts.cash} ₪." },
    { "id": 23, "q": "כמה הזמנות היו בחודש האחרון?", "calls": [["getOrders", {}]], "answer": "סך ההזמנות {getOrders.total} ₪, ממוצע {getOrders.average} ₪ להזמנה." },
    { "id": 24, "q": "כמה הזמנות בוטלו?", "calls": [["getOrders", {}]], "answer": "מתוך {getOrders.count} הזמנות בוטלו {getOrders.cancelled}." },
    { "id": 25, "q": "כמה שילמנו שכר בחודש שעבר?", "opt": ["pay"], "calls": [["getPayroll", { "month": "M1" }]], "answer": "סך השכר: {getPayroll.monthTotal} ₪." },
    { "id": 26, "q": "כמה קיבלה רינה?", "opt": ["pay"], "calls": [["getPayroll", { "employee": "רינה", "month": "M1" }]], "answer": "רינה לוי: {getPayroll.employees.0.total} ₪." },
    { "id": 27, "q": "איך דוד עומד במשימות?", "opt": ["emp"], "calls": [["getEmployeeActivity", { "employee": "דוד", "days": 30 }]], "answer": "לדוד {getEmployeeActivity.tasks.total} משימות, מהן {getEmployeeActivity.tasks.done} בוצעו. לא ידוע אם היה בחופשה." },
    { "id": 28, "q": "כמה הכנסות היו החודש? (מהמראה)", "opt": ["mirror"], "calls": [["getMonthSummary", { "month": "M0" }]], "answer": "ההכנסות החודש: {getMonthSummary.income} ₪." },
    { "id": 29, "q": "כמה חשבוניות פתוחות? (מראה ישן)", "opt": ["mirror", "stale"], "calls": [["getOpenInvoices", {}]], "answer": "סך החשבוניות הפתוחות {getOpenInvoices.total} ₪." },
    { "id": 30, "q": "מה המצב החודש, וכמה אני חייב למאפייה?", "calls": [["getMonthSummary", { "month": "M0" }], ["getSupplierBalance", { "supplier": "מאפיית הצפון" }]], "answer": "החודש הכנסות {getMonthSummary.income} ₪ והוצאות {getMonthSummary.expenses} ₪. למאפיית הצפון: {getSupplierBalance.suppliers.0.balance} ₪." }
