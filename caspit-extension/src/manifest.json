{
  "manifest_version": 3,
  "name": "לארג' פעמי – סנכרון כספית",
  "short_name": "סנכרון כספית",
  "version": "0.1.24",
  "description": "מסנכרן כל לילה את הקטלוג והמכירות מכספית לאפליקציה לארג' פעמי, ומעלה לכספית פריטים חדשים ומחירים.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "storage", "scripting", "idle"],
  "host_permissions": ["https://caspit.valu.co.il/*", "__CXBOT_ORIGIN__/*"],
  "background": { "service_worker": "sw.js" },
  "action": { "default_popup": "popup.html", "default_title": "סנכרון כספית", "default_icon": { "128": "icon.png" } },
  "options_page": "options.html",
  "icons": { "128": "icon.png" },
  "content_scripts": [
    { "matches": ["https://caspit.valu.co.il/*"], "js": ["content/hook-main.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false },
    { "matches": ["https://caspit.valu.co.il/*"], "js": ["content/bridge.js"], "run_at": "document_start", "all_frames": false }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
