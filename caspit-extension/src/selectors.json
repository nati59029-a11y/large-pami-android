        "ms": 15000
      },
      {
        "op": "setFile",
        "t": {
          "css": "input[type=file]",
          "hidden": true
        },
        "file": "csv"
      },
      {
        "op": "click",
        "t": {
          "textAny": [
            "טען קובץ",
            "טעינת קובץ",
            "טען",
            "טעינה",
            "העלה קובץ",
            "העלאה",
            "העלה",
            "ייבוא",
            "יבוא",
            "שלח"
