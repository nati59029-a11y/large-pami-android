          ],
          "tag": "button,a,[role=button],[role=menuitem]"
        },
        "capture": true,
        "safe": true
      }
    ],
    "sales": [
      {
        "op": "nav",
        "hash": "#/sales-items-reports",
        "ms": 3000,
        "fresh": true
      },
      {
        "op": "waitFor",
        "t": {
          "textAny": [
            "צור קובץ"
