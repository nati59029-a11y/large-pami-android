        "safe": true
      },
      {
        "op": "waitFor",
        "t": {
          "css": "input[type=file]",
          "hidden": true
        },
        "ms": 15000
      },
      {
        "op": "setFile",
        "t": {
          "css": "input[type=file]",
          "hidden": true
        },
        "file": "csv"
      },
      {
        "op": "click",
        "t": {
          "textAny": [
            "טען קובץ",
            "טעינת קובץ",
            "טען",
            "טעינה",
            "העלה קובץ",
            "העלאה",
            "העלה",
            "ייבוא",
            "יבוא",
            "שלח"
          ],
          "tag": "button,[role=button],input[type=submit],input[type=button]"
        },
        "submit": true,
        "wait": 3000
      },
      {
        "op": "waitFor",
        "t": {
          "textAny": [
            "הסתיים",
            "נטענו",
            "בהצלחה",
            "שגיאה",
            "שגיאות",
            "הושלם"
          ]
        },
        "ms": 300000
      },
      {
        "op": "text",
        "t": {
          "css": "[role=alert],.alert,.modal-body,.toast,.result,.notification",
          "textAny": [
            "הסתיים",
            "נטענו",
            "בהצלחה",
            "שגיאה",
            "שגיאות",
            "הושלם"
          ]
        },
        "optional": true
      }
    ]
  },
  "disc": [
    {
      "name": "catalogs",
      "hash": "#/catalogs",
      "flow": "catalog"
    },
    {
      "name": "csv-imports",
      "hash": "#/csv-imports",
      "flow": "importNew",
      "peek": [
        {
          "name": "job_type",
          "open": {
            "css": "#job_type"
          },
          "items": ".multiselect__option,[role=option]",
          "within": ".multiselect",
          "max": 40
        }
      ]
    },
    {
      "name": "sales",
      "hash": "#/sales-items-reports",
      "flow": "sales",
      "peek": [
        {
          "name": "from-date",
          "open": {
            "css": ".vdp-datepicker input",
            "nth": 0
          },
          "items": ".vdp-datepicker__calendar header span",
          "within": ".vdp-datepicker",
          "struct": ".vdp-datepicker__calendar",
          "max": 5
        }
      ]
    }
  ]
